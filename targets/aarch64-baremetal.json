{
	"inheritable-only": true,
	"llvm-target": "aarch64-unknown-none",
	"cpu": "cortex-a53",
	"features": "+aes,+crc,+fp-armv8,+neon,+sha2,+strict-align,+v8a,-fmv",
	"goos": "linux",
	"goarch": "arm64",
	"build-tags": ["tinygo.aarch64", "baremetal"],
	"gc": "conservative",
	"scheduler": "none",
	"linker": "ld.lld",
	"rtlib": "compiler-rt",
	"libc": "picolibc",
	"default-stack-size": 65536,
	"cflags": [
		"-Werror",
		"-fshort-enums",
		"-fomit-frame-pointer",
		"-mno-outline-atomics",
		"-fno-exceptions", "-fno-unwind-tables", "-fno-asynchronous-unwind-tables",
		"-ffunction-sections", "-fdata-sections"
	],
	"ldflags": [
		"--gc-sections"
	],
	"extra-files": [
		"src/device/arm64/start.S",
		"src/internal/task/task_stack_arm64.S",
		"src/runtime/asm_arm64.S"
	],
	"gdb": ["gdb-multiarch", "aarch64-unknown-elf-gdb", "gdb"]
}
